{
  "name": "functions",
  "private": true,
  "version": "0.0.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --configLoader runner --pool=threads --maxWorkers=1 --no-file-parallelism --exclude src/integration/**",
    "test:integration": "vitest run src/integration --configLoader runner --pool=threads --maxWorkers=1 --no-file-parallelism",
    "test:coverage": "vitest run --configLoader runner --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --pool=threads --maxWorkers=1 --no-file-parallelism",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
