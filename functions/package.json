{
  "name": "functions",
  "private": true,
  "version": "0.0.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build:shared": "pnpm --dir shared build",
    "prebuild": "pnpm build:shared",
    "build": "tsc",
    "pretest:integration": "pnpm build:shared",
    "pretest:typecheck": "pnpm build:shared",
    "test": "pnpm test:typecheck && vitest run --configLoader runner --pool=threads --maxWorkers=1 --no-file-parallelism --exclude src/integration/**",
    "test:integration": "vitest run src/integration --configLoader runner --pool=threads --maxWorkers=1 --no-file-parallelism",
    "test:coverage": "pnpm test:typecheck && vitest run --configLoader runner --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --pool=threads --maxWorkers=1 --no-file-parallelism",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@sendflow/shared": "file:./shared",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "firebase": "12.6.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
