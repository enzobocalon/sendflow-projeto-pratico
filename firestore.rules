rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsResource() {
      return signedIn() && request.auth.uid == resource.data.userId;
    }

    function ownsIncomingResource() {
      return signedIn() && request.auth.uid == request.resource.data.userId;
    }

    function ownsConnection(connectionId) {
      return connectionId is string
        && exists(/databases/$(database)/documents/connections/$(connectionId))
        && get(/databases/$(database)/documents/connections/$(connectionId)).data.userId == request.auth.uid;
    }

    function validMessageContacts(contactIds) {
      return contactIds is list
        && contactIds.size() > 0
        && contactIds.size() <= 100;
    }

    function validMessageStatus(status) {
      return status in ["sent", "scheduled"];
    }

    function validMessageSchedule() {
      return request.resource.data.status == "sent"
        || request.resource.data.scheduledAt is timestamp;
    }

    function validMessagePayload() {
      return request.resource.data.content is string
        && request.resource.data.content.size() >= 2
        && request.resource.data.content.size() <= 500
        && validMessageStatus(request.resource.data.status)
        && ownsConnection(request.resource.data.connectionId)
        && validMessageContacts(request.resource.data.contactIds)
        && validMessageSchedule();
    }

    match /connections/{connectionId} {
      allow read, update, delete: if ownsResource();
      allow create: if ownsIncomingResource();
    }

    match /contacts/{contactId} {
      allow read, delete: if ownsResource();
      allow create: if ownsIncomingResource()
        && ownsConnection(request.resource.data.connectionId);
      allow update: if ownsResource()
        && ownsIncomingResource()
        && ownsConnection(request.resource.data.connectionId);
    }

    match /messages/{messageId} {
      allow read, delete: if ownsResource();
      allow create: if ownsIncomingResource()
        && validMessagePayload();
      allow update: if ownsResource()
        && ownsIncomingResource()
        && validMessagePayload();
    }
  }
}
